APP_ENV=development
POSTGRES_DB=documind
POSTGRES_USER=documind
POSTGRES_PASSWORD=documind_local_only
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}
# Development-only example. Replace with a unique secret for every real environment.
JWT_SECRET_KEY=dev-only-change-this-secret-before-deployment-32-bytes-minimum
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
DOCUMENT_STORAGE_PATH=./storage/documents
MAX_UPLOAD_SIZE_MB=20
REDIS_URL=redis://localhost:6379/0
CHUNK_MAX_CHARACTERS=3000
CHUNK_OVERLAP_CHARACTERS=200
QDRANT_URL=http://localhost:6333
QDRANT_PORT=6333
QDRANT_COLLECTION=documind_chunks
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_PORT=9200
OPENSEARCH_INDEX=documind_chunks
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
INDEX_BATCH_SIZE=64
